# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environments ---
.venv/
venv/
env/
.env

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (downloaded / generated; reproducible via scripts) ---
data/raw/*
data/processed/*
data/features/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# --- Trained models (reproducible via scripts/run_training.py) ---
models/*
!models/.gitkeep

# --- SHAP cache (large); figures/metrics ARE committed ---
results/shap/*.pkl
results/shap/*.joblib

# --- Kaggle credentials must never be committed ---
kaggle.json
access_token
access_token.txt
credentials.json

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/


# --- local tool config ---
.claude/

# --- run logs ---
logs/

# --- reference paper PDFs: copyrighted, kept local only (see docs/03_reference_papers/INDEX.md for links) ---
docs/03_reference_papers/*.pdf

# --- demo images built from unused dataset images (not redistributed) ---
demo_unseen/
